// PH Typhoon Tracker - Wi-Fi credentials template
//
// Copy this file to include/secrets.h and fill in your real values:
//     Copy-Item include\secrets.h.example include\secrets.h
//
// include/secrets.h is git-ignored, so your password stays out of the
// repository. Without it the firmware builds with placeholder strings.

#define WIFI_SSID       "YOUR_WIFI_SSID"      // 2.4 GHz network name
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"
